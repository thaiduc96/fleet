{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "none",
    "moduleDetection": "legacy",
    "outFile": "app.js",
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["src/*.ts"]
}
